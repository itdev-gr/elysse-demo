---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostView from '../../../components/blog/BlogPostView.tsx';

// Rendered on-demand so a newly published post is live immediately — no
// rebuild. Edge-cached for speed; revalidates within a minute.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
---
<BaseLayout
  title="Article — Elysée"
  description=""
  padForHeader={false}
>
  <BlogPostView slug={slug ?? ''} client:only="react" />
</BaseLayout>
