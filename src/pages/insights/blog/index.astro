---
/**
 * Insights — Blog.
 *
 * Shared cinematic chassis (`InsightsIndex`) + the BlogList island.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';
import BlogList from '../../../components/blog/BlogList.tsx';
---
<BaseLayout
  title="Blog — Insights — Elysée"
  description="In-depth articles on piping technology, installation best practices, and sustainable solutions."
  padForHeader={false}
>
  <InsightsIndex
    heroImage="/images/insights/blog/hero.jpg"
    heroImageAlt="An engineer drafting technical plans on a blueprint."
    eyebrow="Insights · Blog"
    title="Blog."
    subtitle="In-depth articles on piping technology, installation best practices, and sustainable solutions."
    sectionEyebrow="From the blog"
    sectionHeading="Notes from our engineers."
  >
    <BlogList client:visible />
  </InsightsIndex>
</BaseLayout>
