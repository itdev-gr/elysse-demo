---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EbookDetailView from '../../../components/insights/EbookDetailView.tsx';

// Dynamic route rendered on-demand; the row is fetched in the browser so a
// newly published publication is live immediately, and the markdown sanitiser
// (jsdom) stays off the serverless runtime.
export const prerender = false;

const { slug } = Astro.params;
---
<BaseLayout title="eBook — Insights — Elysée" description="">
  <EbookDetailView slug={slug ?? ''} client:only="react" />
</BaseLayout>
