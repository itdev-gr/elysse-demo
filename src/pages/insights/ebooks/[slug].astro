---
export const prerender = false;
import EbookDetail from '../../../components/insights/EbookDetail.astro';
import { getEbookBySlug } from '../../../lib/ebooks';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
const ebook = slug ? await getEbookBySlug(slug) : null;
if (!ebook) return Astro.redirect('/insights/ebooks/', 302);
---
<EbookDetail ebook={ebook} />
