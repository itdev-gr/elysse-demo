---
/**
 * Insights — eBooks.
 *
 * Cinematic hero (matching the Blog/News index pages) + client island. The grid
 * is fetched in the browser from the `ebooks` table, managed in the admin
 * dashboard, so newly published entries appear with no rebuild.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import InsightsList from '../../../components/insights/InsightsList.tsx';
import { i18nAttr } from '../../../lib/i18n';
---
<BaseLayout
  title="eBooks — Insights — Elysée"
  description="Reports, guides and publications from Elysée."
  padForHeader={false}
>
  <section class="relative min-h-[60vh] flex items-end text-surface overflow-hidden bg-ink">
    <Container size="xl" class="relative pt-40 md:pt-48 pb-16 md:pb-24 w-full">
      <p data-i18n={i18nAttr('Insights · eBooks')} class="text-[11px] md:text-xs uppercase tracking-[0.4em] text-surface/85 mb-8">
        Insights · eBooks
      </p>
      <h1 class="font-display font-heavy leading-[0.92] tracking-tight text-surface" style="font-size: clamp(3rem, 9vw, 8rem); max-width: 14ch;">
        eBooks.
      </h1>
      <p data-i18n={i18nAttr('Reports, guides and publications from Elysée.')} class="mt-8 max-w-2xl text-base md:text-lg text-surface/85 leading-relaxed">
        Reports, guides and publications from Elysée.
      </p>
    </Container>
  </section>

  <Section bg="default" spacing="lg">
    <Container size="xl">
      <InsightsList kind="ebooks" emptyMessage="No eBooks published yet — check back soon." client:visible />
    </Container>
  </Section>
</BaseLayout>
