---
/**
 * Insights — eBooks.
 *
 * Static shell + client island (mirrors the Blog/News pattern). The grid is
 * fetched in the browser from the `ebooks` table, managed in the admin
 * dashboard, so newly published entries appear with no rebuild.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import InsightsList from '../../../components/insights/InsightsList.tsx';
---
<BaseLayout
  title="eBooks — Insights — Elysée"
  description="Reports, guides and publications from Elysée."
>
  <PageHero
    title="eBooks"
    eyebrow="Insights"
    subtitle="Reports, guides and publications from Elysée."
  />
  <section class="mx-auto max-w-screen-xl px-4 md:px-8 py-12 md:py-16">
    <InsightsList kind="ebooks" emptyMessage="No eBooks published yet — check back soon." client:visible />
  </section>
</BaseLayout>
