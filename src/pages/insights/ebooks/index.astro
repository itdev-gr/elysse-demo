---
/**
 * Insights — eBooks.
 *
 * Shared cinematic chassis (`InsightsIndex`) + the InsightsList island. The grid
 * is fetched in the browser from the `ebooks` table, managed in the admin
 * dashboard, so newly published entries appear with no rebuild.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';
import InsightsList from '../../../components/insights/InsightsList.tsx';
---
<BaseLayout
  title="eBooks — Insights — Elysée"
  description="Reports, guides and publications from Elysée."
  padForHeader={false}
>
  <InsightsIndex
    heroImage="/images/insights/ebooks/hero.jpg"
    heroImageAlt="An open book floating above a stack of books in a library."
    eyebrow="Insights · eBooks"
    title="eBooks."
    subtitle="Reports, guides and publications from Elysée."
    sectionEyebrow="From the library"
    sectionHeading="Guides, reports and publications."
  >
    <InsightsList kind="ebooks" emptyMessage="No eBooks published yet — check back soon." client:visible />
  </InsightsIndex>
</BaseLayout>
