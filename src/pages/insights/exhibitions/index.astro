---
/**
 * Insights — Exhibitions.
 *
 * Shared cinematic chassis (`InsightsIndex`) + the InsightsList island. The grid
 * is fetched in the browser from the `exhibitions` table, managed in the admin
 * dashboard, so newly published entries appear with no rebuild.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';
import InsightsList from '../../../components/insights/InsightsList.tsx';
---
<BaseLayout
  title="Exhibitions — Insights — Elysée"
  description="Where to meet Elysée — trade fairs and exhibitions across the group."
  padForHeader={false}
>
  <InsightsIndex
    heroImage="/images/insights/exhibitions/hero.jpg"
    heroImageAlt="A packed audience at an industry event, where Elysée meets partners and customers."
    eyebrow="Insights · Exhibitions"
    title="Exhibitions."
    subtitle="Where to meet Elysée — trade fairs and exhibitions across the group."
    sectionEyebrow="On the calendar"
    sectionHeading="Meet Elysée in person."
  >
    <InsightsList kind="exhibitions" emptyMessage="No exhibitions listed yet — check back soon." client:visible />
  </InsightsIndex>
</BaseLayout>
