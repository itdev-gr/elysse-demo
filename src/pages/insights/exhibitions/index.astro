---
/**
 * Insights — Exhibitions.
 *
 * Static shell + client island (mirrors the Blog/News pattern). The grid is
 * fetched in the browser from the `exhibitions` table, managed in the admin
 * dashboard, so newly published entries appear with no rebuild.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import InsightsList from '../../../components/insights/InsightsList.tsx';
---
<BaseLayout
  title="Exhibitions — Insights — Elysée"
  description="Where to meet Elysée — trade fairs and exhibitions across the group."
>
  <PageHero
    title="Exhibitions"
    eyebrow="Insights"
    subtitle="Where to meet Elysée — trade fairs and exhibitions across the group."
  />
  <section class="mx-auto max-w-screen-xl px-4 md:px-8 py-12 md:py-16">
    <InsightsList kind="exhibitions" emptyMessage="No exhibitions listed yet — check back soon." client:visible />
  </section>
</BaseLayout>
