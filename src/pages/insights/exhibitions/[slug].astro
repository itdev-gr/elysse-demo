---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExhibitionDetailView from '../../../components/insights/ExhibitionDetailView.tsx';

// Dynamic route rendered on-demand; the row is fetched in the browser so a
// newly published exhibition is live immediately, and the markdown sanitiser
// (jsdom) stays off the serverless runtime.
export const prerender = false;

const { slug } = Astro.params;
---
<BaseLayout title="Exhibition — Insights — Elysée" description="">
  <ExhibitionDetailView slug={slug ?? ''} client:only="react" />
</BaseLayout>
