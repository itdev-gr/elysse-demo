---
/**
 * Insights — Media.
 *
 * Shared cinematic chassis (`InsightsIndex`) + the InsightsList island. The grid
 * is fetched in the browser from the `media` table, managed in the admin
 * dashboard, so newly published entries appear with no rebuild.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';
import InsightsList from '../../../components/insights/InsightsList.tsx';
---
<BaseLayout
  title="Media — Insights — Elysée"
  description="Videos, photographs, and broadcast coverage featuring Elysée."
  padForHeader={false}
>
  <InsightsIndex
    heroImage="/images/insights/media/hero.jpg"
    heroImageAlt="A professional cinema camera being operated on set."
    eyebrow="Insights · Media"
    title="Media."
    subtitle="Videos, photographs, and broadcast coverage featuring Elysée."
    sectionEyebrow="From the media library"
    sectionHeading="Elysée in pictures and film."
  >
    <InsightsList kind="media" emptyMessage="No media published yet — check back soon." client:visible />
  </InsightsIndex>
</BaseLayout>
