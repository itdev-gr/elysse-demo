---
export const prerender = false;
import MediaDetail from '../../../components/insights/MediaDetail.astro';
import { getMediaBySlug } from '../../../lib/media';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
const media = slug ? await getMediaBySlug(slug) : null;
if (!media) return Astro.redirect('/insights/media/', 302);
---
<MediaDetail media={media} />
