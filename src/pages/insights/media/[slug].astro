---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MediaDetailView from '../../../components/insights/MediaDetailView.tsx';

// Dynamic route rendered on-demand; the row is fetched in the browser so a
// newly published item is live immediately, and the markdown sanitiser
// (jsdom) stays off the serverless runtime.
export const prerender = false;

const { slug } = Astro.params;
---
<BaseLayout title="Media — Insights — Elysée" description="">
  <MediaDetailView slug={slug ?? ''} client:only="react" />
</BaseLayout>
