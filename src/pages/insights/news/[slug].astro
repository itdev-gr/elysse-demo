---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsPostView from '../../../components/news/NewsPostView.tsx';

// Rendered on-demand so a newly published item is live immediately — no
// rebuild. Edge-cached for speed; revalidates within a minute.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
---
<BaseLayout title="News — Elysée" description="" padForHeader={false}>
  <NewsPostView slug={slug ?? ''} client:load />
</BaseLayout>
