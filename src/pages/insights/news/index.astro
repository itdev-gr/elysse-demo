---
/**
 * Insights — News.
 *
 * URL: /insights/news/
 * Source of truth: the `news` table, managed in the admin dashboard
 * (News tab). `insightsNewsItems` from src/data/site-content.ts is the
 * offline fallback for the island.
 *
 * Shared cinematic chassis (`InsightsIndex`) + the NewsList island. New
 * articles appear here as soon as they are published in the dashboard.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';
import NewsList from '../../../components/news/NewsList.tsx';
import { insightsNewsItems } from '../../../data/site-content';
import { slugify } from '../../../lib/posts';

// Offline fallback for the island. Mirrors the seeded rows so the page never
// looks broken if Supabase is unreachable.
const newsFallback = insightsNewsItems.map((it) => ({
  slug: slugify(it.title),
  title: it.title,
  excerpt: it.excerpt ?? '',
  cover_image: it.image ?? null,
  author: null,
  published_at: null,
  reading_minutes: null,
}));
---
<BaseLayout
  title="News — Insights — Elysée"
  description="The latest product launches, company milestones, and industry updates from Elysée."
  padForHeader={false}
>
  <InsightsIndex
    heroImage="/images/about/facility-exterior.jpg"
    heroImageAlt="The Elysée manufacturing facility"
    eyebrow="Insights · Newsroom"
    title="News."
    subtitle="Product launches, company milestones, and industry updates from across the Elysée group."
    sectionEyebrow="From the newsroom"
    sectionHeading="The latest from Elysée."
  >
    <NewsList client:visible fallback={newsFallback} />
  </InsightsIndex>
</BaseLayout>
