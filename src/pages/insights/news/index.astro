---
/**
 * Insights — News.
 *
 * URL: /insights/news/
 * Source of truth: the `news` table, managed in the admin dashboard
 * (News tab). `insightsNewsItems` from src/data/site-content.ts is the
 * offline fallback for the island.
 *
 * Cinematic chassis: parallax cover hero, editorial intro, then the
 * NewsList island (featured-first card grid). New articles appear here as
 * soon as they are published in the dashboard.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import NewsList from '../../../components/news/NewsList.tsx';
import { insightsNewsItems } from '../../../data/site-content';
import { slugify } from '../../../lib/posts';

// Offline fallback for the island. Mirrors the seeded rows so the page never
// looks broken if Supabase is unreachable.
const newsFallback = insightsNewsItems.map((it) => ({
  slug: slugify(it.title),
  title: it.title,
  excerpt: it.excerpt ?? '',
  cover_image: it.image ?? null,
  author: null,
  published_at: null,
  reading_minutes: null,
}));
---
<BaseLayout
  title="News — Insights — Elysée"
  description="The latest product launches, company milestones, and industry updates from Elysée."
  padForHeader={false}
>

  <div aria-hidden="true" data-scroll-progress class="fixed top-0 left-0 right-0 h-[2px] bg-brand-500 z-50 origin-left pointer-events-none" style="transform: scaleX(0);"></div>

  {/* ===== COVER HERO ===== */}
  <section class="relative min-h-[62vh] md:min-h-[70vh] flex items-end text-surface overflow-hidden">
    <img
      data-hero-parallax
      src="/images/about/facility-exterior.jpg"
      alt="The Elysée manufacturing facility"
      class="absolute inset-0 w-full h-full object-cover will-change-transform"
    />
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-b from-ink/45 via-ink/20 to-ink/80"></div>
    <div aria-hidden="true" class="absolute inset-0 bg-brand-500/30"></div>

    <Container size="xl" class="relative pt-40 md:pt-48 pb-14 md:pb-20 w-full">
      <p data-reveal class="text-[11px] md:text-xs uppercase tracking-[0.4em] text-surface/85 mb-8">
        Insights · Newsroom
      </p>
      <h1 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[0.92] tracking-tight text-surface" style="font-size: clamp(3rem, 9vw, 8rem); max-width: 14ch;">
        News.
      </h1>
      <p data-reveal data-reveal-delay="240" class="mt-8 max-w-2xl text-base md:text-lg text-surface/85 leading-relaxed">
        Product launches, company milestones, and industry updates from across the Elysée group.
      </p>
    </Container>
  </section>

  {/* ===== NEWS GRID — managed in the admin dashboard ===== */}
  <Section bg="default" spacing="lg">
    <Container size="xl">
      <header class="max-w-3xl mb-12 md:mb-16">
        <p data-reveal class="text-[11px] uppercase tracking-[0.4em] text-brand-500 mb-6 md:mb-8">From the newsroom</p>
        <h2 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[1.02] tracking-tight text-ink" style="font-size: clamp(2rem, 5vw, 3.75rem);">
          The latest from Elysée.
        </h2>
      </header>

      <NewsList client:visible fallback={newsFallback} />
    </Container>
  </Section>

  {/* ===== motion (scroll bar + hero parallax) ===== */}
  <script>
    import { animate, scroll } from 'motion';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const bar = document.querySelector('[data-scroll-progress]') as HTMLElement | null;
      if (bar) scroll(animate(bar, { transform: ['scaleX(0)', 'scaleX(1)'] }, { ease: 'linear' }));
      const heroImg = document.querySelector('[data-hero-parallax]') as HTMLElement | null;
      const heroSection = heroImg?.closest('section') as HTMLElement | null;
      if (heroImg && heroSection) {
        scroll(
          animate(heroImg, { transform: ['translateY(0)', 'translateY(15%)'] }, { ease: 'linear' }),
          { target: heroSection, offset: ['start start', 'end start'] },
        );
      }
    }
  </script>
</BaseLayout>
