---
/**
 * Quality & Certifications — Compression Fittings.
 *
 * URL: /about-us/quality-certifications/compression-fittings/
 * Source of truth: the `certifications` table (cert_group='quality',
 * category='compression-fittings'), managed in the admin dashboard.
 * QUALITY_CERTIFICATE_SEED['compression-fittings'] (decorated with local
 * badge art + scope copy below) remains the island's offline fallback, and
 * the badges/copy also backfill dashboard rows that lack them.
 *
 * Mirrors the cinematic template established by
 * `/green-elysee/certifications/` and the Management System page:
 * scroll-progress, parallax hero, sticky sub-nav, stat band, editorial
 * intro with sticky aside + drop-cap, full-bleed cinematic moment,
 * certification badge grid with stamp-in effect, closing CTA.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import AboutSubNav from '../../../components/about/AboutSubNav.astro';
import CertificationsGrid from '../../../components/certifications/CertificationsGrid.tsx';
import EnquiryForm from '../../../components/contact/EnquiryForm.tsx';
import {
  QUALITY_CATEGORIES,
  QUALITY_CERTIFICATE_SEED,
} from '../../../data/quality-certificates';

const meta = QUALITY_CATEGORIES.find((c) => c.slug === 'compression-fittings')!;
const seed = QUALITY_CERTIFICATE_SEED['compression-fittings'] ?? [];

// Badge art + copy for the seed certificates, keyed by name. Dashboard rows
// that lack a badge image or copy borrow these inside the grid island.
const decor: Record<string, { logo: string; tag: string; description: string; scope: string }> = {
  'KIWA Certificate PP Clamp Fittings': {
    logo: '/images/certifications/fittings/kiwa.svg',
    tag: 'NL',
    description: 'Dutch KIWA product approval',
    scope: 'PP clamp saddles and tapping fittings approved for drinking-water systems.',
  },
  'Czech Certificate': {
    logo: '/images/certifications/fittings/itc-czech.svg',
    tag: 'CZ',
    description: 'ITC product certification, Czech Republic',
    scope: 'Compression fittings certified by ITC Zlín for the Czech market.',
  },
  'WRAS Certificate': {
    logo: '/images/certifications/fittings/wras.svg',
    tag: 'UK',
    description: 'Water Regulations Advisory Scheme, UK',
    scope: 'Compression fittings approved for contact with UK drinking water.',
  },
  'SAI Certificate': {
    logo: '/images/certifications/fittings/sai.svg',
    tag: 'AU',
    description: 'SAI Global product certification, Australia',
    scope: 'Certified to AS/NZS requirements for the Australian and New Zealand markets.',
  },
  'OFI Certificate EN 12201-3': {
    logo: '/images/certifications/fittings/ofi-en-12201-3.svg',
    tag: 'AT',
    description: 'OFI Austria — EN 12201-3',
    scope: 'Fittings for PE pressure piping systems certified to EN 12201-3.',
  },
  'OVGW Certificate': {
    logo: '/images/certifications/fittings/ovgw.svg',
    tag: 'AT',
    description: 'Austrian gas & water association approval',
    scope: 'ÖVGW approval for fittings in Austrian water-supply networks.',
  },
  'DVGW Elysée': {
    logo: '/images/certifications/fittings/dvgw.svg',
    tag: 'DE',
    description: 'German gas & water association approval',
    scope: 'DVGW approval for compression fittings in German drinking-water networks.',
  },
  'OFI Certificate ISO 17885': {
    logo: '/images/certifications/fittings/ofi-iso-17885.svg',
    tag: 'AT',
    description: 'OFI Austria — ISO 17885',
    scope: 'Plastics fittings for pressure piping systems certified to ISO 17885.',
  },
  'SVGW Certificate': {
    logo: '/images/certifications/fittings/svgw.svg',
    tag: 'CH',
    description: 'Swiss gas & water association approval',
    scope: 'SVGW approval for fittings in Swiss drinking-water installations.',
  },
  'Elysée Zero Force': {
    logo: '/images/certifications/fittings/zero-force.svg',
    tag: 'DE',
    description: 'DVGW — Zero Force range, 20–110 mm',
    scope: 'Zero Force push-in compression fittings certified from 20 mm up to 110 mm.',
  },
  'DVGW Elysée Push Fit': {
    logo: '/images/certifications/fittings/push-fit.svg',
    tag: 'DE',
    description: 'DVGW — Push Fit range',
    scope: 'Push-fit compression fittings certified for German drinking-water networks.',
  },
  'BDS ISO 17885:2022': {
    logo: '/images/certifications/fittings/bds-iso-17885.svg',
    tag: 'BG',
    description: 'Bulgarkontrola — ISO 17885:2022',
    scope: 'Bulgarian certification of plastics fittings to ISO 17885:2022.',
  },
  'SII Elysée Rohrsysteme Zero Force': {
    logo: '/images/certifications/fittings/sii.svg',
    tag: 'IL',
    description: 'Standards Institution of Israel',
    scope: 'Zero Force PN10/PN16 fittings certified by SII for the Israeli market.',
  },
  'WRAS Elysée Epsilon Series': {
    logo: '/images/certifications/fittings/wras-epsilon.svg',
    tag: 'UK',
    description: 'WRAS — Epsilon series',
    scope: 'Epsilon-series fittings approved for contact with UK drinking water.',
  },
  'Poland ITB': {
    logo: '/images/certifications/fittings/itb.svg',
    tag: 'PL',
    description: 'Building Research Institute, Poland',
    scope: 'ITB technical approval for the Polish construction market.',
  },
  'Poland PZH Certificate': {
    logo: '/images/certifications/fittings/pzh.svg',
    tag: 'PL',
    description: 'National Institute of Hygiene, Poland',
    scope: 'PZH hygienic certificate for drinking-water contact in Poland.',
  },
  'SAI WaterMark Certificate': {
    logo: '/images/certifications/fittings/watermark.svg',
    tag: 'AU',
    description: 'WaterMark plumbing approval, Australia',
    scope: 'WaterMark certification for plumbing and drainage products in Australia.',
  },
  'Elysée AgriFlow': {
    logo: '/images/certifications/fittings/agriflow.svg',
    tag: 'IE',
    description: 'NSAI certification, Ireland',
    scope: 'AgriFlow fittings certified by NSAI for the Irish market.',
  },
  'ÖA Registration Certificate': {
    logo: '/images/certifications/fittings/oa.svg',
    tag: 'AT',
    description: 'Austrian registration certificate',
    scope: 'ÖA registration for Elysée Rohrsysteme products in Austria.',
  },
  'Slovakia Certificate': {
    logo: '/images/certifications/fittings/vusapl.svg',
    tag: 'SK',
    description: 'VÚSAPL certification, Slovakia',
    scope: 'Compression fittings certified by VÚSAPL for the Slovak market.',
  },
};

// Server-rendered fallback for the island when Supabase is unreachable.
const certFallback = seed.map((c) => ({
  name: c.name,
  description: c.description ?? decor[c.name]?.description ?? null,
  scope: decor[c.name]?.scope ?? null,
  tag: decor[c.name]?.tag ?? null,
  logo: decor[c.name]?.logo ?? null,
  pdf_url: c.pdf_url,
}));

const certCount = certFallback.length;
const desc = `${meta.blurb} ${certCount} approvals from certification bodies across twelve markets — every certificate is downloadable as a PDF.`;
---
<BaseLayout title={`${meta.title} — Quality & Certifications — Elysée`} description={desc} padForHeader={false}>

  <div aria-hidden="true" data-scroll-progress class="fixed top-0 left-0 right-0 h-[2px] bg-brand-500 z-50 origin-left pointer-events-none" style="transform: scaleX(0);"></div>

  {/* ===== COVER HERO ===== */}
  <section class="relative min-h-[88vh] flex items-end text-surface overflow-hidden">
    <img
      data-hero-parallax
      src="/images/about/pipe-stack.jpg"
      alt="Stacked Elysée piping — the systems joined by the certified compression-fitting range"
      class="absolute inset-0 w-full h-full object-cover will-change-transform"
    />
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-b from-ink/45 via-ink/20 to-ink/80"></div>
    <div aria-hidden="true" class="absolute inset-0 bg-brand-500/30"></div>

    <Container size="xl" class="relative pt-40 md:pt-48 pb-16 md:pb-24 w-full">
      <p data-reveal class="text-[11px] md:text-xs uppercase tracking-[0.4em] text-surface/85 mb-8">
        Quality &amp; Certifications · {meta.title} · Independently audited
      </p>
      <h1 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[0.92] tracking-tight text-surface" style="font-size: clamp(3rem, 9vw, 8rem); max-width: 14ch;">
        Approved, by certificate.
      </h1>
      <p data-reveal data-reveal-delay="240" class="mt-8 max-w-2xl text-base md:text-lg text-surface/85 leading-relaxed">
        {meta.blurb}
      </p>
      <div data-reveal data-reveal-delay="360" class="mt-14 md:mt-20 flex items-center gap-4 text-[11px] uppercase tracking-[0.3em] text-surface/70">
        <span aria-hidden="true" class="h-px w-12 bg-surface/50"></span>
        <span><span data-cert-count>{certCount}</span> certified approvals</span>
      </div>
    </Container>
  </section>

  <AboutSubNav currentPath={Astro.url.pathname} />

  {/* ===== STAT BAND ===== */}
  <section class="bg-surface border-b border-ink/10">
    <Container size="xl" class="py-16 md:py-24">
      <p data-reveal class="text-[11px] md:text-xs uppercase tracking-[0.3em] text-brand-500 mb-10 md:mb-14">The fittings programme</p>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-ink/10 border border-ink/10">
        <div class="bg-surface p-8 md:p-10">
          <dd data-counter={String(certCount)} data-cert-count class="font-display font-heavy leading-none tracking-tight text-brand-500" style="font-size: clamp(2.5rem, 6vw, 5rem);">{certCount}</dd>
          <dt class="mt-4 md:mt-5 text-[10px] md:text-xs uppercase tracking-[0.25em] text-ink/60">Product certificates</dt>
        </div>
        <div class="bg-surface p-8 md:p-10">
          <dd data-counter="12" class="font-display font-heavy leading-none tracking-tight text-brand-500" style="font-size: clamp(2.5rem, 6vw, 5rem);">12</dd>
          <dt class="mt-4 md:mt-5 text-[10px] md:text-xs uppercase tracking-[0.25em] text-ink/60">Markets covered</dt>
        </div>
        <div class="bg-surface p-8 md:p-10">
          <dd class="font-display font-heavy leading-none tracking-tight text-brand-500" style="font-size: clamp(2rem, 5vw, 4rem);">EN + ISO</dd>
          <dt class="mt-4 md:mt-5 text-[10px] md:text-xs uppercase tracking-[0.25em] text-ink/60">Standard families</dt>
        </div>
        <div class="bg-surface p-8 md:p-10">
          <dd class="font-display font-heavy leading-none tracking-tight text-brand-500" style="font-size: clamp(2rem, 5vw, 4rem);">Annual</dd>
          <dt class="mt-4 md:mt-5 text-[10px] md:text-xs uppercase tracking-[0.25em] text-ink/60">Audit cadence</dt>
        </div>
      </dl>
    </Container>
  </section>

  {/* ===== EDITORIAL INTRO ===== */}
  <Section bg="alt" spacing="lg">
    <Container size="xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <p data-reveal class="text-[11px] uppercase tracking-[0.4em] text-brand-500 mb-6 md:mb-8">Why approvals matter</p>
            <h2 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[1.02] tracking-tight text-ink" style="font-size: clamp(2rem, 4.5vw, 3.5rem);">
              One fitting. Twelve markets.
            </h2>
            <div aria-hidden="true" class="mt-8 h-px w-12 bg-brand-500"></div>
            <p data-reveal data-reveal-delay="240" class="mt-6 max-w-xs text-sm text-ink/60 leading-relaxed">
              From KIWA to WaterMark — every market Elysée fittings ship to has its own approval body, and the range is certified in each one.
            </p>
          </div>
        </aside>
        <div class="lg:col-span-8 lg:pt-2 space-y-7 md:space-y-8">
          <p
            data-reveal
            data-reveal-delay="160"
            class="text-lg md:text-xl text-ink leading-[1.65]
                   first-letter:font-display first-letter:font-heavy
                   first-letter:text-7xl md:first-letter:text-8xl
                   first-letter:float-left first-letter:mr-3 first-letter:mt-1
                   first-letter:leading-[0.85] first-letter:text-brand-500"
          >
            Drinking water is the most regulated product there is — and every country guards it with its own approval scheme. The Elysée compression-fitting range carries them across Europe and beyond: DVGW in Germany, WRAS in the UK, KIWA in the Netherlands, SVGW in Switzerland, ÖVGW in Austria, WaterMark in Australia, and more.
          </p>
          <p data-reveal data-reveal-delay="280" class="text-base md:text-lg text-ink/80 leading-relaxed">
            Each approval below is issued by an independent national body against EN 12201-3, ISO 17885, or the local water-contact regulations — and each one is downloadable as the current PDF, ready for tenders, specifications, and regulatory submissions.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  {/* ===== CINEMATIC MOMENT ===== */}
  <section class="relative min-h-[55vh] flex items-center text-surface overflow-hidden">
    <img src="/images/about/pipes-warehouse.jpg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover" />
    <div aria-hidden="true" class="absolute inset-0 bg-ink/65"></div>
    <div aria-hidden="true" class="absolute inset-0 bg-brand-500/35 mix-blend-multiply"></div>
    <Container size="lg" class="relative py-20 md:py-28 w-full">
      <div class="max-w-4xl mx-auto text-center">
        <p data-reveal class="text-[11px] md:text-xs uppercase tracking-[0.4em] text-surface/75 mb-8">Worldwide approvals</p>
        <blockquote data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[1.05] tracking-tight" style="font-size: clamp(2rem, 5vw, 4.5rem);">
          <span aria-hidden="true" class="text-surface/55">&ldquo;</span>Approved at home — wherever home is.<span aria-hidden="true" class="text-surface/55">&rdquo;</span>
        </blockquote>
      </div>
    </Container>
  </section>

  {/* ===== CERTIFICATIONS GRID — badge cards with PDF download links ===== */}
  <Section bg="alt" spacing="lg">
    <Container size="xl">
      <a
        data-reveal
        href="/about-us/quality-certifications/"
        class="group cursor-pointer inline-flex items-center gap-2 mb-10 md:mb-12 text-[11px] uppercase tracking-[0.25em] text-ink/60 hover:text-brand-500 transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        <span>All certificate categories</span>
      </a>

      <header class="max-w-3xl mb-12 md:mb-16">
        <p data-reveal class="text-[11px] uppercase tracking-[0.4em] text-brand-500 mb-6 md:mb-8">Our Compression Fittings Certifications</p>
        <h2 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[1.02] tracking-tight text-ink" style="font-size: clamp(2.25rem, 5.5vw, 4.5rem);">
          <span data-cert-count>{certCount}</span> standards. <span data-cert-count>{certCount}</span> PDFs.
        </h2>
        <p data-reveal data-reveal-delay="240" class="mt-6 md:mt-8 text-base md:text-lg text-ink/70 leading-relaxed">
          Tap any badge below to download the current certificate.
        </p>
      </header>

      {/* Cards are managed in the admin dashboard (Certifications tab). */}
      <CertificationsGrid client:visible group="quality" category="compression-fittings" columns={5} fallback={certFallback} />
    </Container>
  </Section>

  {/* ===== CLOSING CTA — request a certificate ===== */}
  <section class="bg-brand-500/10">
    <Container size="xl" class="py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div class="lg:pt-4">
          <p data-reveal class="text-[11px] uppercase tracking-[0.4em] text-brand-500 mb-6">Request a certificate</p>
          <p data-reveal data-reveal-delay="120" class="text-base md:text-lg text-ink/80 leading-relaxed max-w-xl">
            Need an older certificate, a tender-ready bundle, or an approval for a market you don't see here? Our team can prepare it on request.
          </p>
          <a
            data-reveal
            data-reveal-delay="240"
            href="/contact/local/"
            class="group cursor-pointer mt-8 md:mt-10 inline-flex items-center gap-3 px-6 py-3 border border-ink/40 hover:bg-ink hover:border-ink hover:text-surface text-ink text-[11px] md:text-xs uppercase tracking-[0.25em] transition-colors duration-200"
          >
            <span>Contact our local network</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div data-reveal data-reveal-delay="200" class="bg-surface p-6 md:p-8 border border-ink/10">
          <EnquiryForm
            client:visible
            source="compression-fittings-certifications"
            title="Request a certificate"
            subtitle="Tell us which approval, market, or product family you need evidence for — our quality team will prepare it."
          />
        </div>
      </div>
    </Container>
  </section>

  {/* ===== motion (scroll bar + hero parallax) ===== */}
  <script>
    import { animate, scroll } from 'motion';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const bar = document.querySelector('[data-scroll-progress]') as HTMLElement | null;
      if (bar) scroll(animate(bar, { transform: ['scaleX(0)', 'scaleX(1)'] }, { ease: 'linear' }));
      const heroImg = document.querySelector('[data-hero-parallax]') as HTMLElement | null;
      const heroSection = heroImg?.closest('section') as HTMLElement | null;
      if (heroImg && heroSection) {
        scroll(
          animate(heroImg, { transform: ['translateY(0)', 'translateY(15%)'] }, { ease: 'linear' }),
          { target: heroSection, offset: ['start start', 'end start'] },
        );
      }
    }
  </script>

  {/* Certification grid stamp-in animation lives inside CertificationsGrid. */}
</BaseLayout>
