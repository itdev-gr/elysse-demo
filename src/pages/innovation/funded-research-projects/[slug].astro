---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FundedProjectView from '../../../components/funded/FundedProjectView.tsx';

// Rendered on-demand so a newly published project is live immediately — no
// rebuild. Edge-cached for speed; revalidates within a minute.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
---
<BaseLayout title="Funded Research Projects — Elysée" description="" padForHeader={false}>
  <FundedProjectView slug={slug ?? ''} client:only="react" />
</BaseLayout>
