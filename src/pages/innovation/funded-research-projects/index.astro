---
/**
 * Innovation — Funded Research Projects.
 *
 * URL: /innovation/funded-research-projects/
 * Source of truth: the `funded_projects` table, managed in the admin dashboard
 * (Insights → Funded Projects tab). Projects appear here as soon as published.
 *
 * Hero copy/image + the intro paragraph still come from `innovationFundedProjects`
 * (site-content.ts); the project cards are a data-driven client island.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import InnovationSubNav from '../../../components/innovation/InnovationSubNav.astro';
import ContentBlocks from '../../../components/ContentBlocks.astro';
import FundedProjectsList from '../../../components/funded/FundedProjectsList.tsx';
import { innovationFundedProjects } from '../../../data/site-content';
---
<BaseLayout title={`${innovationFundedProjects.title} — Elysée`} description={innovationFundedProjects.subtitle ?? innovationFundedProjects.title}>
  <PageHero
    title={innovationFundedProjects.title}
    eyebrow={innovationFundedProjects.eyebrow}
    subtitle={innovationFundedProjects.subtitle}
    image={innovationFundedProjects.heroImage}
    imageAlt={innovationFundedProjects.heroImageAlt}
    compact
  />
  <InnovationSubNav currentPath={Astro.url.pathname} />
  <section class="mx-auto max-w-screen-xl px-4 md:px-8 py-12 md:py-16">
    <div class="max-w-3xl mb-10 md:mb-14">
      <ContentBlocks blocks={innovationFundedProjects.blocks} />
    </div>
    <FundedProjectsList client:visible />
  </section>
</BaseLayout>
