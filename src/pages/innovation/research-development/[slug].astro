---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResearchPostView from '../../../components/research/ResearchPostView.tsx';

// Rendered on-demand so a newly published entry is live immediately — no
// rebuild. Edge-cached for speed; revalidates within a minute.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
---
<BaseLayout title="Research & Development — Elysée" description="" padForHeader={false}>
  <ResearchPostView slug={slug ?? ''} client:only="react" />
</BaseLayout>
