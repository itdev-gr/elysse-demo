---
/**
 * Product configuration detail page.
 *
 * URL: /catalog/<category>/<config-slug>  (e.g. /catalog/compression-fittings/epsilon-series-pn16-330)
 * One page per configuration (catalogue No.), listing all its sizes. Paths and
 * data come from the Supabase-backed `products` table via fetchConfigurationDetails.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConfigDetail from '../../../components/catalog/ConfigDetail.astro';
import { fetchConfigurationDetails, configDetailToCard } from '../../../lib/products';
import { getCategories, getSubcategories } from '../../../lib/categories';
import type { CatalogProduct, CategorySlug } from '../../../scripts/catalog/types';
import '../../../styles/catalog.css';
import { supabase } from '../../../lib/supabase';
import CatalogueButton from '../../../components/catalog/CatalogueButton.astro';

// Rendered on-demand so a newly added/edited product is live immediately — no
// rebuild. Edge-cached for speed; revalidates within a minute.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { category, product } = Astro.params as { category: string; product: string };
const categoryEntry = (await getCategories()).find((c) => c.slug === category);
if (!categoryEntry || !categoryEntry.product_category_name) return new Response(null, { status: 404 });

let configs;
try {
  configs = await fetchConfigurationDetails(categoryEntry.product_category_name, categoryEntry.slug as CategorySlug);
} catch (err) {
  console.error(`catalog product "${product}": fetch failed`, err);
  return new Response(null, { status: 404 });
}
const config = configs.find((x) => x.slug === product);
if (!config) return new Response(null, { status: 404 });

type CatalogueSubRow = {
  pdf_url_black: string | null;
  pdf_url_blue: string | null;
  groups_black: string[] | null;
  groups_blue: string[] | null;
};
let subRow: CatalogueSubRow | null = null;
if (config.subCategory) {
  const { data } = await supabase
    .from('catalogues')
    .select(`
      pdf_url_black, pdf_url_blue, groups_black, groups_blue,
      parent:parent_id!inner ( category_slug )
    `)
    .eq('product_sub_category', config.subCategory)
    .eq('parent.category_slug', categoryEntry.slug)
    .eq('is_active', true)
    .maybeSingle();
  if (data) {
    subRow = {
      pdf_url_black: data.pdf_url_black,
      pdf_url_blue: data.pdf_url_blue,
      groups_black: data.groups_black,
      groups_blue: data.groups_blue,
    };
  }
}

const categoryName = categoryEntry.name;
const categoryNameI18n = JSON.stringify(categoryEntry.name_i18n ?? {});
// Series (sub-category) translations for the swap of the line under the title.
const subOverlay = (await getSubcategories()).find(
  (s) => s.category_slug === categoryEntry.slug && s.name === config.subCategory,
);
const subCategoryI18n = subOverlay?.name_i18n ?? {};
// Related: other configurations in the same series first, then the rest.
const sameSeries = configs.filter((x) => x.slug !== config.slug && x.subCategory === config.subCategory);
const others = configs.filter((x) => x.slug !== config.slug && x.subCategory !== config.subCategory);
const related: CatalogProduct[] = [...sameSeries, ...others].slice(0, 4).map(configDetailToCard);

const desc = `${config.configuration} (No.${config.familyCode}) — ${config.subCategory}. ${config.sizes.length} sizes available.`;
---
<BaseLayout title={`${config.configuration} — ${categoryName} — Elysée`} description={desc} padForHeader={false}>
  <div class="catalog-scope pt-24 md:pt-28 px-4 md:px-8">
    <section class="mx-auto max-w-screen-xl pb-16">
      <nav aria-label="Breadcrumb" class="text-xs text-ink/60">
        <a href="/" class="hover:text-brand-500">Home</a>
        <span class="mx-2">/</span>
        <a href="/products/" class="hover:text-brand-500">Products</a>
        <span class="mx-2">/</span>
        <a href={`/catalog/${config.categorySlug}/`} class="hover:text-brand-500" data-i18n={categoryNameI18n}>{categoryName}</a>
        <span class="mx-2">/</span>
        <span aria-current="page">{config.configuration}</span>
      </nav>

      <a href={`/catalog/${config.categorySlug}/`} data-back-link class="group mt-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.25em] text-ink/60 hover:text-brand-500 transition-colors duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        <span>Back to <span data-i18n={categoryNameI18n}>{categoryName}</span></span>
      </a>

      <ConfigDetail config={config} related={related} subCategoryI18n={subCategoryI18n}>
        <CatalogueButton slot="catalogue-button" catalogue={subRow} />
      </ConfigDetail>
    </section>
  </div>
</BaseLayout>

<script>
  // "Back" returns the visitor to the exact page they came from (restoring its
  // scroll position and any applied filters) when they arrived from elsewhere on
  // this site. Otherwise — a direct landing, external referrer, or a reload —
  // the anchor's href navigates to the category listing as a sensible fallback.
  const backLink = document.querySelector<HTMLAnchorElement>('[data-back-link]');
  if (backLink && document.referrer) {
    try {
      const from = new URL(document.referrer);
      const cameFromSite = from.origin === location.origin && from.pathname !== location.pathname;
      if (cameFromSite) {
        backLink.addEventListener('click', (e) => {
          // Let modified clicks (open in new tab, etc.) follow the href instead.
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          e.preventDefault();
          history.back();
        });
      }
    } catch {
      /* Malformed referrer — keep the href fallback. */
    }
  }
</script>
