---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CatalogProduct, CategorySlug } from '../../../scripts/catalog/types';
import { fetchCatalogConfigurations } from '../../../lib/products';
import '../../../styles/catalog.css';
import UtilityBar from '../../../components/catalog/UtilityBar.astro';
import ProductGrid from '../../../components/catalog/ProductGrid.astro';
import CountryModal from '../../../components/catalog/CountryModal.astro';
import CategoriesNav from '../../../components/catalog/CategoriesNav.astro';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((c) => ({
    params: { category: c.data.slug ?? c.id },
    props: { categoryEntry: c },
  }));
}

const { category } = Astro.params as { category: CategorySlug };
const { categoryEntry } = Astro.props;

// Excel-backed categories pull from Supabase; the rest stay empty as before.
const EXCEL_CATEGORY_NAME: Partial<Record<string, string>> = {
  'compression-fittings': 'Compression Fittings',
  'hydraulic-fittings': 'Hydraulic Fittings',
  'saddles': 'Saddles',
};
const excelName = EXCEL_CATEGORY_NAME[category];
// One card per configuration (catalogue No.), sizes collapsed — matches the
// printed catalogue layout.
const products: CatalogProduct[] = excelName ? await fetchCatalogConfigurations(excelName) : [];

const categoryProducts = products; // already filtered to this category
const isEmpty = categoryProducts.length === 0;

// Distinct product series (sub-categories) in catalogue order. `material` holds
// the sub_category; shown under the title and wired as `materials` filters so
// tapping one narrows the grid via the existing filter engine.
const seriesSeen = new Set<string>();
const series: string[] = [];
for (const p of products) {
  const s = p.material;
  if (s && !seriesSeen.has(s)) {
    seriesSeen.add(s);
    series.push(s);
  }
}

const productsJson = JSON.stringify(products);
---
<BaseLayout title={`${categoryEntry.data.name} — Catalog — Elysée`} description={categoryEntry.data.blurb} padForHeader={false}>
  <div class="catalog-scope pt-24 md:pt-28 px-4 md:px-8" data-catalog-root>
    {!isEmpty && <CountryModal />}
    <section class="mx-auto max-w-screen-xl pb-12">
      <nav aria-label="Breadcrumb" class="text-xs text-ink/60">
        <a href="/" class="hover:text-brand-500">Home</a>
        <span class="mx-2">/</span>
        <a href="/products/" class="hover:text-brand-500">Products</a>
        <span class="mx-2">/</span>
        <span aria-current="page">{categoryEntry.data.name}</span>
      </nav>

      <header class="mt-6 mb-8">
        <h1 class="text-3xl md:text-4xl font-heavy text-ink">{categoryEntry.data.name}</h1>
      </header>

      {isEmpty ? (
        <div class="grid grid-cols-12 gap-6 py-6">
          <aside class="col-span-12 md:col-span-3">
            <div class="md:sticky md:top-24">
              <CategoriesNav active={category} subCategories={series} />
            </div>
          </aside>
          <section class="col-span-12 md:col-span-9 flex flex-col items-center justify-center py-24 text-center">
            <p class="text-xl font-heavy text-ink">No products in this category yet.</p>
            <p class="text-sm text-ink/70 mt-2">We're still cataloguing this section. Coming soon.</p>
            <a href="/products/" class="mt-6 inline-block text-xs uppercase tracking-widest font-medium text-brand-500 hover:text-brand-accent">Back to all categories →</a>
          </section>
        </div>
      ) : (
        <div class="grid grid-cols-12 gap-6 py-6">
          <aside class="col-span-12 md:col-span-3">
            <div class="md:sticky md:top-24">
              <CategoriesNav active={category} subCategories={series} />
            </div>
          </aside>
          <section class="col-span-12 md:col-span-9">
            <UtilityBar count={categoryProducts.length} />
            <ProductGrid products={categoryProducts} />
          </section>
        </div>
      )}

      <pre data-products-json style="display:none">{productsJson}</pre>
    </section>
  </div>
  <script>
    import { initCatalogPage } from '../../../scripts/catalog/page-init';
    import { openCountryModal } from '../../../scripts/catalog/country-modal';
    import { readCountry, writeCountry } from '../../../scripts/catalog/country';

    function go() {
      const empty = !document.querySelector('[data-country-modal]');
      if (empty) return;
      const parts = window.location.pathname.split('/').filter(Boolean);
      const category = parts[1];

      // `?country=ask` is appended by the Products mega-nav so the picker opens
      // every time the user enters a category from there — even if a country is
      // already stored. The param is stripped from the URL after a pick so a
      // refresh or shared link doesn't re-fire the modal.
      const params = new URLSearchParams(window.location.search);
      const forceAsk = params.get('country') === 'ask';
      const cleanUrl = () => {
        if (!forceAsk) return;
        const url = new URL(window.location.href);
        url.searchParams.delete('country');
        const search = url.searchParams.toString();
        history.replaceState({}, '', url.pathname + (search ? `?${search}` : '') + url.hash);
      };

      const stored = readCountry();
      if (stored && !forceAsk) {
        initCatalogPage(stored, category as any);
        return;
      }
      openCountryModal((picked) => {
        writeCountry(picked);
        cleanUrl();
        initCatalogPage(picked, category as any);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
    else go();
  </script>
</BaseLayout>
