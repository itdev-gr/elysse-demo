---
/**
 * Shared ContentBlock renderer — extracted from ContentPageLayout so detail
 * pages (projects, articles, exhibitions, media, ebooks) render body blocks
 * with the exact same typography/spacing as the main content pages.
 */
import StatGrid from './StatGrid.astro';
import Timeline from './Timeline.astro';
import ValueList from './ValueList.astro';
import StrategyPillars from './StrategyPillars.astro';
import ImageGrid from './innovation/ImageGrid.astro';
import ProcessIcons from './innovation/ProcessIcons.astro';
import PartnersWall from './innovation/PartnersWall.astro';
import ProjectsList from './innovation/ProjectsList.astro';
import IdeaForm from './innovation/IdeaForm.tsx';
import type { ContentBlock } from '../data/site-content';
import { i18nAttr } from '../lib/i18n';

interface Props { blocks: ContentBlock[]; }
const { blocks } = Astro.props;
---
{blocks.map((b) => {
  if (b.kind === 'heading' && b.level === 2) return <h2 data-i18n={i18nAttr(b.text)} class="text-2xl md:text-3xl font-heavy text-ink mt-8 first:mt-0">{b.text}</h2>;
  if (b.kind === 'heading' && b.level === 3) return <h3 data-i18n={i18nAttr(b.text)} class="text-xl font-heavy text-ink mt-6">{b.text}</h3>;
  if (b.kind === 'paragraph') return <p data-i18n={i18nAttr(b.text)} class="text-base md:text-lg text-ink/85 leading-relaxed max-w-screen-md">{b.text}</p>;
  if (b.kind === 'list') {
    const Tag = b.ordered ? 'ol' : 'ul';
    const cls = b.ordered ? 'list-decimal' : 'list-disc';
    return <Tag class={`${cls} pl-6 space-y-2 text-base md:text-lg text-ink/85 max-w-screen-md`}>{b.items.map((i) => <li data-i18n={i18nAttr(i)}>{i}</li>)}</Tag>;
  }
  if (b.kind === 'callout') return (
    <aside class="p-6 md:p-8 bg-brand-500/5 border-l-4 border-brand-500 rounded-sm max-w-screen-md">
      {b.title && <h3 data-i18n={i18nAttr(b.title)} class="text-lg font-heavy text-brand-500 mb-2">{b.title}</h3>}
      <p data-i18n={i18nAttr(b.body)} class="text-base md:text-lg text-ink/85">{b.body}</p>
    </aside>
  );
  if (b.kind === 'stats') return <StatGrid items={b.items} />;
  if (b.kind === 'timeline') return <Timeline items={b.items} />;
  if (b.kind === 'pillars') return <StrategyPillars intro={b.intro} items={b.items} />;
  if (b.kind === 'valuelist') return <ValueList items={b.items} />;
  if (b.kind === 'image') return (
    <figure class="my-8">
      <div class={`overflow-hidden bg-brand-500/5 ${b.ratio === '16/9' ? 'aspect-video' : b.ratio === '1/1' ? 'aspect-square' : 'aspect-[4/3]'}`}>
        <img src={b.src} alt={b.alt} loading="lazy" class="w-full h-full object-cover" />
      </div>
      {b.caption && <figcaption data-i18n={i18nAttr(b.caption)} class="mt-2 text-sm text-ink/65">{b.caption}</figcaption>}
    </figure>
  );
  if (b.kind === 'imagegrid') return <ImageGrid intro={b.intro} columns={b.columns} items={b.items} />;
  if (b.kind === 'process-icons') return <ProcessIcons items={b.items} />;
  if (b.kind === 'partners') return <PartnersWall items={b.items} cta={b.cta} />;
  if (b.kind === 'projects') return <ProjectsList heading={b.heading} items={b.items} />;
  if (b.kind === 'idea-form') return (
    <IdeaForm
      client:visible
      heroImage={b.heroImage}
      confidentialityTitle={b.confidentialityTitle}
      confidentialityBody={b.confidentialityBody}
      generalSubmissionLabel={b.generalSubmissionLabel}
      generalSubmissionHref={b.generalSubmissionHref}
    />
  );
  return null;
})}
