---
import { COUNTRIES } from '../../data/catalog-countries';
import { supabase } from '../../lib/supabase';

const { data: mapped } = await supabase
  .from('group_countries').select('country_code, country').order('country', { ascending: true });
const codes = new Set((mapped ?? []).map((m: { country_code: string | null }) => m.country_code?.toLowerCase()).filter(Boolean));
// Fallback: the full static list when Supabase is unreachable.
const pool = codes.size > 0 ? COUNTRIES.filter((c) => codes.has(c.code)) : COUNTRIES;

// Featured markets pinned above a separator, in this order.
const TOP_CODES: readonly string[] = ['cy', 'at', 'eg', 'lb', 'gr'];
const topCountries = TOP_CODES
  .map((code) => pool.find((c) => c.code === code))
  .filter((c): c is (typeof COUNTRIES)[number] => Boolean(c));
const otherCountries = pool
  .filter((c) => !TOP_CODES.includes(c.code))
  .slice()
  .sort((a, b) => a.label.localeCompare(b.label));
const groups = [topCountries, otherCountries].filter((g) => g.length > 0);
---
<div
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center px-4"
  data-country-modal
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="country-modal-title"
>
  <div class="absolute inset-0" aria-hidden="true"></div>
  <div class="relative bg-surface text-ink rounded-md shadow-xl max-w-md w-full p-6 md:p-8">
    <h2 id="country-modal-title" class="text-2xl font-heavy text-ink">Select your country</h2>
    <p class="text-sm text-ink/70 mt-2">Product availability varies by region. Choose your country to browse the catalog.</p>

    <div class="relative mt-6" data-country-picker>
      <button
        type="button"
        data-country-trigger
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label="Country"
        class="flex w-full items-center justify-between gap-3 bg-surface border border-ink/20 rounded-sm px-4 py-3 text-sm text-ink/50 cursor-pointer transition-colors duration-fast hover:border-ink/40 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30"
      >
        <span data-country-label data-placeholder="Choose your country…">Choose your country…</span>
        <svg
          data-country-chevron
          viewBox="0 0 12 12"
          aria-hidden="true"
          class="h-2.5 w-2.5 shrink-0 transition-transform duration-200"
        >
          <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <ul
        data-country-menu
        role="listbox"
        aria-label="Country"
        class="mt-2 hidden max-h-[min(15rem,35vh)] overflow-y-auto overscroll-contain rounded-md border border-surface-divider bg-surface text-ink shadow-lg py-1"
      >
        {groups.map((group, i) => (
          <Fragment>
            {i > 0 && <li role="separator" aria-hidden="true" class="my-1 border-t border-surface-divider"></li>}
            {group.map((c) => (
              <li>
                <button
                  type="button"
                  role="option"
                  aria-selected="false"
                  data-country-option
                  data-value={c.code}
                  class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors duration-150 hover:bg-surface-alt hover:text-brand-500 focus:outline-none focus-visible:bg-surface-alt focus-visible:text-brand-500 cursor-pointer"
                >
                  <span class="w-7 shrink-0 text-[11px] uppercase tracking-wider font-semibold">{c.code}</span>
                  <span class="text-sm" data-country-option-name>{c.label}</span>
                </button>
              </li>
            ))}
          </Fragment>
        ))}
      </ul>
    </div>

    <button
      type="button"
      data-country-submit
      disabled
      class="mt-6 w-full inline-flex items-center justify-center gap-3 px-6 py-3 bg-brand-500 text-surface text-[11px] md:text-xs uppercase tracking-[0.25em] font-medium hover:bg-brand-700 transition-colors duration-200 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-brand-500"
    >
      <span>Continue</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>
  </div>
</div>
<noscript>
  <p class="fixed inset-x-0 top-0 z-50 bg-brand-500 text-surface text-center py-3 text-sm">
    Please enable JavaScript to browse the catalog.
  </p>
</noscript>
