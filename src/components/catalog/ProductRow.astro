---
import type { CatalogProduct } from '~/scripts/catalog/types';
interface Props { product: CatalogProduct; }
const { product: p } = Astro.props;
const thumb = p.imageUrls[0] ?? p.image ?? '';
---
<article class="cat-card flex items-center gap-4 p-4" data-product-row data-slug={p.slug} data-series={p.material}>
  <div class="flex-shrink-0 w-[72px] h-[72px] bg-surface-alt rounded-sm flex items-center justify-center overflow-hidden">
    {thumb ? (
      <img src={thumb} alt={p.name} loading="lazy" width="72" height="72" class="w-full h-full object-contain p-2" />
    ) : (
      <span class="text-ink/15" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="7" width="18" height="10" rx="2" />
          <circle cx="8.5" cy="12" r="2.5" />
          <path d="M11.5 12H19" />
        </svg>
      </span>
    )}
  </div>
  <div class="flex-1 min-w-0">
    {p.code && <p class="text-[11px] text-ink/50">No.{p.code}</p>}
    <p class="font-heavy text-lg text-ink leading-tight">{p.name}</p>
    {p.material && <p class="text-xs text-ink/60 mt-0.5">{p.material}</p>}
  </div>
</article>
