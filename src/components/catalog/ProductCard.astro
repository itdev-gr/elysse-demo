---
import type { CatalogProduct } from '~/scripts/catalog/types';

interface Props { product: CatalogProduct; }
const { product: p } = Astro.props;

const fallback = p.imageUrls[0] ?? p.image ?? '';
const detailUrl = `/catalog/${p.categorySlug}/${p.slug}`;
const Media = p.hasDetailPage ? 'a' : 'div';
---
<article
  class="group relative flex flex-col bg-surface border border-ink/10 rounded-md overflow-hidden transition-colors duration-200 ease-out hover:border-brand-500/40"
  data-product-card
  data-slug={p.slug}
  data-series={p.material}
>
  <Media
    href={p.hasDetailPage ? detailUrl : undefined}
    class="relative block aspect-square bg-surface-alt overflow-hidden"
  >
    {fallback ? (
      <img src={fallback} alt={p.name} loading="lazy" width="320" height="320"
        class="absolute inset-0 w-full h-full object-contain p-5 transition-transform duration-300 ease-out group-hover:scale-[1.03]" />
    ) : (
      <span class="absolute inset-0 flex items-center justify-center text-ink/15" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="7" width="18" height="10" rx="2" />
          <circle cx="8.5" cy="12" r="2.5" />
          <path d="M11.5 12H19" />
        </svg>
      </span>
    )}
  </Media>

  <div class="p-4 md:p-5">
    {p.code && <p class="text-xs md:text-sm text-ink/45">No.{p.code}</p>}
    {p.hasDetailPage ? (
      <a href={detailUrl} data-i18n={JSON.stringify(p.nameI18n ?? {})} class="mt-0.5 block font-heavy text-base md:text-lg leading-snug text-ink hover:text-brand-500 transition-colors duration-200">{p.name}</a>
    ) : (
      <p data-i18n={JSON.stringify(p.nameI18n ?? {})} class="mt-0.5 font-heavy text-base md:text-lg leading-snug text-ink">{p.name}</p>
    )}
  </div>
</article>
