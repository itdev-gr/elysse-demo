---
import type { SkuRow } from '~/scripts/catalog/sku-tables';
import { i18nAttr } from '~/lib/i18n';
interface Props {
  rows: SkuRow[];
  title?: string;
}
const { rows, title = 'Available sizes' } = Astro.props;

const hasCountrySplit = rows.some(r => r.code1 || r.code2);
const hasMoq = rows.some(r => r.moq !== undefined && String(r.moq) !== '0' && r.moq !== '');
const hasNpt = rows.some(r => r.npt !== undefined && String(r.npt) !== '0' && r.npt !== '');
const hasNote = rows.some(r => r.note);

function display(v: number | string | undefined): string {
  if (v === undefined) return '';
  if (v === 0 || v === '0') return '';
  return String(v);
}
---
{rows.length > 0 && (
  <section class="sku-table-wrap mt-2">
    {title && <h3 class="font-mono text-[11px] uppercase tracking-wider text-ink/70 mb-2" data-i18n={i18nAttr(title)}>{title}</h3>}
    <div class="overflow-x-auto border border-ink/10 rounded-md">
      <table class="sku-table w-full text-sm">
        <thead>
          <tr>
            <th rowspan="2" class="px-3 py-2 text-center" data-i18n={i18nAttr('Code')}>Code</th>
            <th rowspan="2" class="px-3 py-2 text-center" data-i18n={i18nAttr('Characteristics')}>Characteristics</th>
            <th colspan="2" class="px-3 py-1 text-center border-b border-white/30" data-i18n={i18nAttr('Packing (pcs)')}>Packing (pcs)</th>
            {hasMoq && <th rowspan="2" class="px-3 py-2 text-center">MOQ</th>}
            {hasNpt && <th rowspan="2" class="px-3 py-2 text-center">NPT</th>}
            {hasNote && <th rowspan="2" class="px-3 py-2 text-center">Note</th>}
          </tr>
          <tr>
            <th class="px-3 py-1 text-center font-normal" data-i18n={i18nAttr('Bag')}>Bag</th>
            <th class="px-3 py-1 text-center font-normal" data-i18n={i18nAttr('Box')}>Box</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class={i % 2 === 1 ? 'bg-ink/5' : ''} data-size-countries={r.countries ? r.countries.join(',') : undefined}>
              <td class="px-3 py-1.5 text-center font-mono">
                {hasCountrySplit ? (
                  <>
                    <span data-for-country="country-1">{r.code1 ?? ''}</span>
                    <span data-for-country="country-2">{r.code2 ?? ''}</span>
                  </>
                ) : (r.code ?? '')}
              </td>
              <td class="px-3 py-1.5 text-center">{r.size}</td>
              <td class="px-3 py-1.5 text-center">{display(r.bag)}</td>
              <td class="px-3 py-1.5 text-center">{display(r.box)}</td>
              {hasMoq && <td class="px-3 py-1.5 text-center">{display(r.moq)}</td>}
              {hasNpt && <td class="px-3 py-1.5 text-center">{display(r.npt)}</td>}
              {hasNote && <td class="px-3 py-1.5 text-center">{r.note ?? ''}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p data-sku-empty hidden class="text-sm text-ink/60 mt-2">
      No sizes are currently available in your country.
    </p>
  </section>
)}

<script>
  // Hide sizes not sold in the visitor's country (rows carrying
  // data-size-countries — the DB catalog). Legacy/static tables have no such
  // attribute and are untouched. Country is fixed per page load, matching the
  // CatalogueButton hydration pattern.
  import { readCountry } from '../../scripts/catalog/country';
  import { skuRowVisibleFor } from '../../scripts/catalog/sku-tables';

  function applySkuCountryFilter() {
    const country = readCountry();
    document.querySelectorAll<HTMLElement>('.sku-table-wrap').forEach((wrap) => {
      const trs = Array.from(wrap.querySelectorAll<HTMLTableRowElement>('tbody tr'));
      const hasCountryRows = trs.some((tr) => tr.hasAttribute('data-size-countries'));
      if (!hasCountryRows) return;
      let visible = 0;
      for (const tr of trs) {
        const attr = tr.getAttribute('data-size-countries');
        const ok = skuRowVisibleFor(attr === null ? undefined : attr.split(',').filter(Boolean), country);
        tr.hidden = !ok;
        // Re-stripe the zebra background across the rows that remain.
        if (ok) tr.classList.toggle('bg-ink/5', visible++ % 2 === 1);
      }
      const box = wrap.querySelector<HTMLElement>('.overflow-x-auto');
      const empty = wrap.querySelector<HTMLElement>('[data-sku-empty]');
      if (box) box.hidden = visible === 0;
      if (empty) empty.hidden = visible > 0;
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applySkuCountryFilter);
  else applySkuCountryFilter();
</script>

<style is:global>
  .sku-table thead tr th {
    background: var(--color-brand-500);
    color: var(--color-surface);
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: 12px;
    border-color: rgba(255, 255, 255, 0.3);
  }
  .sku-table tbody tr {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .sku-table tbody tr:last-child {
    border-bottom: none;
  }
</style>
