---
// Thin Astro wrapper around the backend-connected EnquiryForm island.
// Submissions are stored in Supabase and emailed to the per-source recipient
// configured in the admin dashboard (Settings tab).
import EnquiryForm from './contact/EnquiryForm.tsx';

interface Props {
  source?: string;
  title?: string;
  subtitle?: string;
}
const {
  source = 'general',
  title = 'Get in touch',
  subtitle = 'Send us a message and a member of the Elysée team will get back to you.',
} = Astro.props;
---
<section class="mt-16 md:mt-20 max-w-3xl mx-auto">
  <EnquiryForm client:visible source={source} title={title} subtitle={subtitle} />
</section>
