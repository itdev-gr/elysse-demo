---
// Demo search bar shown in the nav, right after the language toggle.
//
// VISUAL SHOWCASE ONLY — submission is disabled and nothing is queried yet;
// the real search wiring is a later task. Styling inherits the header's
// `currentColor`, so the field adapts to both header states: light text over
// the transparent (over-hero) bar and dark text once the bar turns opaque.
//
// Desktop-only (`hidden lg:flex`) to keep the mobile bar uncluttered.
import { i18nAttrFor } from '../lib/i18n';
---
<form
  role="search"
  data-nav-search
  aria-label="Site search"
  data-i18n-attr={i18nAttrFor({ 'aria-label': 'Site search' })}
  class="relative hidden lg:flex items-center shrink-0"
>
  <span class="pointer-events-none absolute left-3 flex items-center text-current/55">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="m21 21-4.3-4.3" />
    </svg>
  </span>
  <input
    type="search"
    name="q"
    autocomplete="off"
    placeholder="Search…"
    data-i18n-attr={i18nAttrFor({ placeholder: 'Search…' })}
    class="w-40 xl:w-52 rounded-full border border-current/25 bg-transparent py-1.5 pl-9 pr-3 text-[12px] leading-none text-current placeholder:text-current/55 transition-colors duration-200 focus:border-brand-500 focus:outline-none"
  />
</form>

<script>
  // Demo only: stop the form from submitting / navigating until search exists.
  document.querySelectorAll<HTMLFormElement>('[data-nav-search]').forEach((f) => {
    f.addEventListener('submit', (e) => e.preventDefault());
  });
</script>
