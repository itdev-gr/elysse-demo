---
/**
 * Closing band for /innovation/why-innovation/ — bg-brand-500/10 wash with
 * the "Keep going" heading + CTAs on the left and an enquiry form card on
 * the right (mirrors the two-column closing pattern on the green pages).
 * Submissions land in the dashboard Messages tab under source
 * "why-innovation"; the recipient email is editable in dashboard Settings.
 */
import Container from '../../Container.astro';
import EnquiryForm from '../../contact/EnquiryForm.tsx';
---
<section class="bg-brand-500/10">
  <Container size="xl" class="py-16 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div class="lg:pt-4">
        <p data-reveal class="text-[11px] uppercase tracking-[0.4em] text-brand-500 mb-6">Keep going</p>
        <h2 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-tight tracking-tight text-ink max-w-xl" style="font-size: clamp(1.5rem, 3.5vw, 2.5rem);">
          See how the process plays out in the lab — or bring us your idea.
        </h2>
        <div data-reveal data-reveal-delay="240" class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href="/innovation/research-development/"
            class="group cursor-pointer inline-flex items-center justify-center gap-2 bg-brand-500 text-surface px-6 py-3 text-[11px] uppercase tracking-[0.25em] font-medium hover:bg-brand-700 transition-colors duration-200"
          >
            <span>Visit R&amp;D</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a
            href="/innovation/innovate-with-us/"
            class="group cursor-pointer inline-flex items-center justify-center gap-2 border border-ink/40 text-ink px-6 py-3 text-[11px] uppercase tracking-[0.25em] font-medium hover:bg-ink hover:text-surface hover:border-ink transition-colors duration-200"
          >
            <span>Submit an idea</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div data-reveal data-reveal-delay="200" class="bg-surface p-6 md:p-8 border border-ink/10">
        <EnquiryForm
          client:visible
          source="why-innovation"
          title="Talk to the innovation team"
          subtitle="Questions about how we innovate, or an idea worth exploring? Send it over and the Elysée innovation team will get back to you."
        />
      </div>
    </div>
  </Container>
</section>
