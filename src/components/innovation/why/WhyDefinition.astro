---
/**
 * "What is innovation?" — a short editorial definition band.
 * Mirrors the project's existing eyebrow + display heading + lead-paragraph
 * pattern (see Section "Why one hub" on contact/worldwide). Uses the global
 * `data-reveal` IntersectionObserver fades — no React island needed.
 */
import Container from '../../Container.astro';
import Section from '../../Section.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
}
const { eyebrow = 'Definition', heading, body } = Astro.props;
---
<Section bg="default" spacing="lg">
  <Container size="xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <aside class="lg:col-span-4">
        <p data-reveal class="text-[11px] uppercase tracking-[0.4em] text-brand-500 mb-6 md:mb-8">{eyebrow}</p>
        <h2 data-reveal data-reveal-delay="120" class="font-display font-heavy leading-[1.02] tracking-tight text-ink" style="font-size: clamp(2rem, 4.5vw, 3.5rem);">
          {heading}
        </h2>
        <div aria-hidden="true" class="mt-8 h-px w-12 bg-brand-500"></div>
      </aside>
      <div class="lg:col-span-8 lg:pt-2">
        <p data-reveal data-reveal-delay="240" class="text-lg md:text-xl text-ink/85 leading-[1.65] max-w-prose">
          {body}
        </p>
      </div>
    </div>
  </Container>
</Section>
