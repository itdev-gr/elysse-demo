---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContentBlocks from '../../components/ContentBlocks.astro';
import { i18nAttr } from '../../lib/i18n';
import type { ProjectDetail } from '../../data/site-content';

interface Props { project: ProjectDetail; }
const { project } = Astro.props;

const statusColor =
  project.status === 'Ongoing'
    ? 'bg-emerald-500/10 text-emerald-700 border-emerald-500/30'
    : 'bg-ink/5 text-ink/70 border-ink/15';
---
<BaseLayout title={project.name} description={project.excerpt}>
  <PageHero title={project.name} eyebrow="Innovation · Funded Research Projects" subtitle={project.excerpt} />

  <article class="mx-auto max-w-screen-md px-4 md:px-8 py-12 md:py-16 space-y-6">
    {/* Project logo — object-contain on a soft tint, mirroring ProjectCard */}
    <figure data-reveal class="bg-brand-500/5 border border-ink/10 rounded-sm overflow-hidden">
      <img
        src={project.image}
        alt={project.imageAlt}
        loading="eager"
        width="640"
        height="400"
        class="w-full max-h-72 object-contain p-8 md:p-10"
      />
    </figure>

    {/* Funding metadata band */}
    <section data-reveal aria-label="Project facts" class="bg-surface border border-ink/10 rounded-sm p-6 md:p-8">
      <div class="flex items-center gap-3 flex-wrap mb-5">
        <span data-i18n={i18nAttr(project.status)} class={`inline-block px-3 py-1 text-[10px] uppercase tracking-widest font-medium border rounded-sm ${statusColor}`}>
          {project.status}
        </span>
      </div>
      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div>
          <dt data-i18n={i18nAttr('Duration')} class="text-[10px] uppercase tracking-widest text-ink/60 font-medium">Duration</dt>
          <dd class="mt-1 font-heavy text-ink">{project.duration}</dd>
        </div>
        <div>
          <dt data-i18n={i18nAttr('Total Funding')} class="text-[10px] uppercase tracking-widest text-ink/60 font-medium">Total Funding</dt>
          <dd class="mt-1 font-heavy text-ink">{project.totalFunding}</dd>
        </div>
        {project.elyseeFunding && (
          <div>
            <dt data-i18n={i18nAttr('Elysée Funding')} class="text-[10px] uppercase tracking-widest text-ink/60 font-medium">Elysée Funding</dt>
            <dd class="mt-1 font-heavy text-ink">{project.elyseeFunding}</dd>
          </div>
        )}
      </dl>
      {project.partners && project.partners.length > 0 && (
        <div class="mt-6 pt-6 border-t border-ink/10">
          <p data-i18n={i18nAttr('Partners')} class="text-[10px] uppercase tracking-widest text-ink/60 font-medium">Partners</p>
          <ul class="mt-3 space-y-2 text-sm md:text-base text-ink/85">
            {project.partners.map((p) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class="mt-[0.55em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <ContentBlocks blocks={project.blocks} />

    <nav aria-label="Back to funded research projects" class="pt-8 mt-8 border-t border-ink/10">
      <a
        href="/innovation/funded-research-projects/"
        class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 hover:text-brand-accent transition-colors duration-150"
      >
        <span aria-hidden="true">←</span> <span data-i18n={i18nAttr('Back to Funded Research Projects')}>Back to Funded Research Projects</span>
      </a>
    </nav>
  </article>
</BaseLayout>
