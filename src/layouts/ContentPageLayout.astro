---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentBlocks from '../components/ContentBlocks.astro';
import type { ContentPage } from '../data/site-content';

interface Props { content: ContentPage; }
const { content } = Astro.props;
const desc = content.metaDescription
  ?? content.blocks.find((b) => b.kind === 'paragraph')?.text?.slice(0, 160)
  ?? content.title;

const wideKinds = ['imagegrid', 'partners', 'projects', 'process-icons', 'idea-form'] as const;
const wide = content.blocks.some((b) => (wideKinds as readonly string[]).includes(b.kind));
---
<BaseLayout title={content.title} description={desc}>
  <PageHero
    title={content.title}
    eyebrow={content.eyebrow}
    subtitle={content.subtitle}
    image={content.heroImage}
    imageAlt={content.heroImageAlt}
  />
  <article class={`mx-auto px-4 md:px-8 py-12 md:py-16 space-y-6 ${wide ? 'max-w-screen-xl' : 'max-w-screen-md'}`}>
    <ContentBlocks blocks={content.blocks} />
  </article>
</BaseLayout>
